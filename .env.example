# ============================================================
# Variables d'environnement — copier dans .env et remplir
# ============================================================

# --- Client Vite (exposées au navigateur, préfixe VITE_) ---
# URL du projet Supabase (Settings > API > Project URL)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clé anon publique Supabase (Settings > API > anon public)
# Sûre à exposer côté client : la RLS protège les données
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Serveur uniquement (api/, jamais dans src/) ---
# Clé service_role Supabase (Settings > API > service_role secret)
# DANGER : contourne la RLS — ne jamais exposer côté client
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Sel pour le hachage des adresses IP (chaîne aléatoire longue)
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Ne jamais exposer côté client
IP_HASH_SALT=changez-moi-avec-une-valeur-aleatoire-longue
