# ============================================================
# Variables d'environnement — copier dans .env.local et remplir
# Règle : ne jamais renommer ces variables.
# Les seuls noms autorisés sont ceux listés ici.
# ============================================================

# --- Client Vite (exposées au navigateur, préfixe VITE_ obligatoire) ---

# URL du projet Supabase (Settings > API > Project URL)
VITE_SUPABASE_URL=

# Clé publique Supabase (Settings > API > anon / publishable)
# Sûre à exposer côté client : la RLS protège les données
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Serveur uniquement (api/ uniquement, jamais dans src/) ---

# Clé service_role Supabase (Settings > API > service_role secret)
# DANGER : contourne la RLS — ne jamais exposer côté client
SUPABASE_SECRET_KEY=

# Sel pour le hachage des adresses IP (chaîne aléatoire ≥ 32 caractères)
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=

# Clé API Groq pour l'assistant IA des visiteurs (api/ uniquement)
# Créer sur https://console.groq.com/keys
GROQ_API_KEY=

# Modèle Groq (facultatif, défaut : llama-3.3-70b-versatile)
GROQ_MODEL=
